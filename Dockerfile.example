FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

# 1. [可选] 替换 APT 源为阿里云(国内加速;海外/内网部署可删除)
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

# 2. 系统依赖:--no-install-recommends 最小化安装
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libopenblas0 \
    mesa-vulkan-drivers \
    libvulkan1 \
    libvulkan-dev \
    spirv-headers \
    glslc \
    cmake \
    build-essential \
    ccache \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 3. Python 依赖:构建时装进镜像,运行时挂载的代码覆盖 /app 但不影响已装依赖。
#    仅装核心 6 项:monitoring(pythonnet)为 Windows 专用、tray(pystray)需 GUI,均不进容器。
#    (pip 源阿里云;海外部署可换官方源)
COPY . /app
RUN pip install --no-cache-dir -e . -i https://mirrors.aliyun.com/pypi/simple/

# 4. 启动:python -m llm_manager = parent+worker 自重启(配置变更重启由内置 parent 处理,
#    退出码 81 是 parent↔worker 内部信号,不经 docker)。compose 的 restart: unless-stopped
#    仅兜底 parent 自身崩溃(崩溃不自愈,可见失败)。
CMD ["python", "-m", "llm_manager"]
